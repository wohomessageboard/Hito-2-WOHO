# Copia este archivo a .env (local). En Vercel se define en Settings → Environment Variables.
# Dirección de la API del backend, terminada en /api y SIN barra final.
#   Local:       http://localhost:4310/api
#   Producción:  https://TU-BACKEND.vercel.app/api
VITE_API_URL=http://localhost:4310/api

# Opcional: Google Analytics 4 (formato G-XXXXXXXXXX). Sin esta variable no se carga nada de Google.
# Si la activas, sube la versión de los textos legales (src/legal/config.js y backend config/legal.js).
# VITE_GA4_ID=

# Publicidad (Google AdSense) — opcional y apagada por defecto. Con VITE_ADSENSE_CLIENT se activan
# la etiqueta de verificación, ads.txt, los anuncios y el enlace "Preferencias de publicidad", y
# la política de privacidad y los Términos cambian solos. Al activarla, sube la versión de los textos
# legales (src/legal/config.js y backend config/legal.js). Los números de unidad salen de AdSense.
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT_FEED=
# VITE_ADSENSE_SLOT_RAIL=
# VITE_ADSENSE_SLOT_POST=
# VITE_ADSENSE_SLOT_MOBILE=
# VITE_ADSENSE_TEST=1   # solo en pruebas: marca las peticiones como de prueba
