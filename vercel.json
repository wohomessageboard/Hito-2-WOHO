{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "woho-three.vercel.app" }],
      "destination": "https://driftler.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "https://woho-backend.onrender.com/api/share/posts/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
